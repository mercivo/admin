# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=seo_platform
DB_SYNCHRONIZE=false
DB_SCHEMA_BOOTSTRAP=false
SEED_DATA_ENABLED=false
SYSTEM_ADMIN_BOOTSTRAP_ENABLED=true

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production

# Google Cloud Storage 商品图片（服务账号 JSON 通过 Docker 只读挂载）
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_PRIVATE_BUCKET=
GCS_PUBLIC_BASE_URL=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs-key.json
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@mercivo.local
ADMIN_PASSWORD=replace_with_a_strong_password
SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_PASSWORD=aihubflux@2026
DEMO_TENANT_PHONE=13800000000
DEMO_TENANT_PASSWORD=replace_with_a_strong_demo_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 应用
APP_PORT=3000
NODE_ENV=development

# 公开站/反向代理
# 只有以下 Host 允许通过 ?site=slug 预览，生产自定义域名不得加入。
STOREFRONT_PREVIEW_HOSTS=localhost,127.0.0.1,preview.example.com
CORS_ORIGINS=http://localhost:8088,https://admin.example.com
# API 前的可信反向代理层数，用于真实 IP 限流。
TRUST_PROXY_HOPS=1

# OpenAI-compatible translation agent runtime (keys stay server-side)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
