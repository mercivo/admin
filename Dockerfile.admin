FROM node:20-alpine AS builder
WORKDIR /app
ARG VITE_STOREFRONT_PREVIEW_URL=https://site.aihubflux.com
ENV VITE_STOREFRONT_PREVIEW_URL=$VITE_STOREFRONT_PREVIEW_URL
COPY frontend/package*.json ./
RUN npm ci --legacy-peer-deps
COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy/cloudrun/admin.runtime.nginx.conf.template /etc/nginx/templates/default.conf.template
ENV API_INTERNAL_URL=https://mercivo-api-753805870951.asia-east1.run.app
ENV API_INTERNAL_HOST=mercivo-api-753805870951.asia-east1.run.app
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
