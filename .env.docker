# Docker 环境变量配置（复制为 .env 后使用 docker-compose）
# 或直接通过 docker-compose.yml 中的 environment 配置

# 数据库
DB_PASSWORD=seo_platform_2024
DB_DATABASE=seo_platform
DB_SCHEMA_BOOTSTRAP=false
# 默认不写入演示租户、商品或账号
SEED_DATA_ENABLED=false
SYSTEM_ADMIN_BOOTSTRAP_ENABLED=true

# JWT
JWT_SECRET=seo-jwt-secret-change-in-production

# Google Cloud Storage 商品图片
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_PUBLIC_BASE_URL=

# 系统管理员（上线时必须通过安全变量管理覆盖）
SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_PASSWORD=aihubflux@2026

# 生产域名与 TLS（上线前必须替换）
ADMIN_DOMAIN=admin.example.com
STOREFRONT_CNAME_TARGET=sites.example.com
TLS_EMAIL=ops@example.com
APP_ORIGIN=https://admin.example.com
API_ORIGIN=https://admin.example.com
