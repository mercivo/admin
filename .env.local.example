# Local Docker Compose configuration. Copy to .env.local before first use.
# Container-to-container addresses stay in docker-compose.yml; only local choices live here.
ENV_FILE=.env.local

# Published ports
DB_HOST_PORT=3307
REDIS_HOST_PORT=6381
API_PORT=3000
ADMIN_PORT=8088
STOREFRONT_PORT=8080
STOREFRONT_URL=http://localhost:8080

# Database
DB_PASSWORD=mercivo_local_db_password
DB_DATABASE=seo_platform
DB_POOL_MAX=5
DB_SYNCHRONIZE=false
# Local fresh databases bootstrap entities before migrations. Cloud Run keeps this false.
DB_SCHEMA_BOOTSTRAP=true

# Bootstrap data
SEED_DATA_ENABLED=false
SYSTEM_ADMIN_BOOTSTRAP_ENABLED=true
SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_PASSWORD=mercivo_local_admin_password
ADMIN_EMAIL=admin@mercivo.local
ADMIN_PASSWORD=mercivo_local_admin_password
DEMO_TENANT_PHONE=13800000000
DEMO_TENANT_PASSWORD=mercivo_local_tenant_password

# API security and browser access
JWT_SECRET=mercivo-local-jwt-secret-change-before-sharing
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:8088,http://localhost:8080
STOREFRONT_PREVIEW_HOSTS=localhost,127.0.0.1
STOREFRONT_CNAME_TARGET=localhost
TRUST_PROXY_HOPS=1

# Optional Google Cloud Storage
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_PUBLIC_BASE_URL=

# Optional production gateway overlay (docker-compose.production.yml)
ADMIN_DOMAIN=admin.example.com
TLS_EMAIL=ops@example.com
