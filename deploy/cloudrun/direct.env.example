# Non-secret environment variables for the single-service Cloud Run deployment.
NODE_ENV=production
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_DATABASE=seo_platform
DB_SOCKET_PATH=/cloudsql/mercivo-admin:asia-east1:mercivo-mysql
DB_POOL_MAX=5
DB_SYNCHRONIZE=false
DB_SCHEMA_BOOTSTRAP=false
SEED_DATA_ENABLED=false
SYSTEM_ADMIN_BOOTSTRAP_ENABLED=true
SYSTEM_ADMIN_USERNAME=admin
TRUST_PROXY_HOPS=1
STOREFRONT_CNAME_TARGET=sites.mercivo.com

# Configure these three values from Secret Manager, not as plain text here:
# DB_PASSWORD=mercivo-db-password:latest
# JWT_SECRET=mercivo-jwt-secret:latest
# SYSTEM_ADMIN_PASSWORD=mercivo-system-admin-password:latest
