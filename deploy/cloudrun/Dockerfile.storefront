FROM node:20-alpine AS builder
WORKDIR /app
COPY storefront/package*.json ./
RUN npm ci
COPY storefront/ ./
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/dist ./dist
COPY storefront/server.mjs ./server.mjs
EXPOSE 8080
CMD ["node", "server.mjs"]
