FROM node:20-alpine AS builder
WORKDIR /app
ARG VITE_STOREFRONT_PATH_HOSTS=site.aihubflux.com
ENV VITE_STOREFRONT_PATH_HOSTS=$VITE_STOREFRONT_PATH_HOSTS
COPY storefront/package*.json ./
RUN npm ci
COPY storefront/ ./
COPY frontend/src /frontend/src
RUN ln -s /app/node_modules /frontend/node_modules
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/dist ./dist
COPY storefront/server.mjs ./server.mjs
COPY storefront/edge-host.mjs ./edge-host.mjs
EXPOSE 8080
USER node
CMD ["node", "server.mjs"]
